#!/bin/sh
# ステージ済みの変更に秘密情報・公開してはならない語・入れてはならないファイルが
# あればコミットを止める。有効化: git config core.hooksPath .githooks（push 前は pre-push）。
# 検査の中身は confidential-check.sh。gitleaks や語の一覧が無いときも止める。
. "$(dirname "$0")/confidential-check.sh"
confidential_find_gitleaks || exit 1
git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n' |
  confidential_path_check "ステージ済みのファイル" || exit 1
"$GL" git --pre-commit --staged --redact=100 --no-banner || exit 1
git diff --cached --text -U0 --no-color | confidential_denylist_check "ステージ済みの変更" || exit 1
